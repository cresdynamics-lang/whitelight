# Copy to .env.do (gitignored) for migration scripts + local API against DigitalOcean.

# --- DigitalOcean Postgres ---
DATABASE_URL=postgresql://user:pass@host:25060/whitelight?sslmode=require

# --- DigitalOcean Spaces (optional if using local /uploads only) ---
SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
SPACES_REGION=fra1
SPACES_BUCKET=whitelight-product-images
SPACES_KEY=
SPACES_SECRET=
SPACES_CDN_BASE=https://whitelight-product-images.fra1.cdn.digitaloceanspaces.com

# --- API ---
PORT=8080
ADMIN_JWT_SECRET=change-me-long-random
CORS_ORIGIN=http://localhost:8080
PUBLIC_BASE_URL=https://whitelightstore.co.ke
UPLOADS_DIR=/var/www/whitelight/uploads

# --- Admin login (upsert: node server/scripts/upsert-admin.mjs) ---
ADMIN_EMAIL=admin@whitelightstore.co.ke
ADMIN_PASSWORD=

# --- Meta (feeds / CAPI) ---
META_PIXEL_ID=1363117562189477
META_ACCESS_TOKEN=

# --- Groq vision (primary) ---
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# --- Gemini vision (fallback) ---
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash

# --- Pesapal ---
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=sandbox

# --- SPA build ---
# VITE_API_BASE_URL=same-origin
