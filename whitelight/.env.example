# Backend API — leave unset for same-origin /api (recommended on DigitalOcean).
# VITE_API_BASE_URL=same-origin

# --- Catalog ads & analytics (browser) ---
# Meta Pixel ID (Events Manager → Data sources → Pixel)
VITE_META_PIXEL_ID=1060087716452785

# Google Analytics 4 measurement ID (Admin → Data streams)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Server-only (build + API on droplet) ---
# DATABASE_URL=postgresql://whitelight:pass@127.0.0.1:5432/whitelight
# Used at build time for catalog.json: npm run generate:catalog-json

# Meta Conversions API
# META_PIXEL_ID=1060087716452785
# META_ACCESS_TOKEN=your_capi_access_token

# Admin seed (run on server): node server/scripts/upsert-admin.mjs
# ADMIN_EMAIL=admin@whitelightstore.co.ke
# ADMIN_PASSWORD=your-secure-password

# Groq vision (primary) + Gemini fallback — server .env only
# GROQ_API_KEY=
# GEMINI_API_KEY=

# --- Pesapal (server) ---
# PESAPAL_CONSUMER_KEY=
# PESAPAL_CONSUMER_SECRET=
# PESAPAL_ENV=sandbox
# PUBLIC_BASE_URL=https://whitelightstore.co.ke
